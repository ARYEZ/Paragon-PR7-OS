#!/bin/sh
# The installer's branding and launcher, no KDE welcome tour, the initramfs with the splash (the system's name
# and the look come from paragon-pr7os-look).
set -e
# the installer: our branding, and its launcher named for us
if [ -f /etc/calamares/settings.conf ]; then
    sed -i 's/^branding:.*/branding: paragon/' /etc/calamares/settings.conf
fi
# the installer's disks: encrypted by default (LUKS2, a plain /boot, unlocked through the splash): Debian's settings
# with those keys changed, printed into the build's log; the build stops if they didn't take
python3 /usr/share/paragon/calamares_partition.py /etc/calamares/modules/partition.conf
grep -q '^preCheckEncryption: true' /etc/calamares/modules/partition.conf
grep -q 'noEncrypt: true' /etc/calamares/modules/partition.conf
# "Install Debian" is written in the launcher and in the script that puts it on the live desktop: rename it everywhere
grep -rlZ "Install Debian" /usr/bin /usr/sbin /usr/share/applications /etc/xdg /etc/skel 2>/dev/null \
    | xargs -0 -r sed -i -e 's/Install Debian/Install Paragon PR7-OS/g' -e '/^Name\[/d'
for f in $(grep -rl "^Exec=.*install-debian" /usr/share/applications 2>/dev/null); do
    sed -i -e 's/^Icon=.*/Icon=pr7os/' "$f"
done
# KDE's first-login tour (its own branding in blue and green): the desktop opens straight to PR7-OS
apt-get purge -y plasma-welcome || true
# the boot test's unlock question (only with paragon.asktest on the kernel line; nothing otherwise): asked from the
# initramfs exactly as cryptsetup asks for an encrypted disk's password, so the test proves the splash can show it
mkdir -p /etc/initramfs-tools/scripts/init-premount
cat > /etc/initramfs-tools/scripts/init-premount/paragon-asktest <<'ASK'
#!/bin/sh
PREREQ="plymouth"
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
grep -qw paragon.asktest /proc/cmdline || exit 0
command -v plymouth >/dev/null || exit 0
sleep 3
# what the splash has at this moment (for the boot test's report)
{ echo "== ping"; plymouth --ping && echo running || echo "not running"
  echo "== cmdline"; cat /proc/cmdline
  echo "== dri"; ls -la /dev/dri 2>&1
  echo "== themes"; ls -R /usr/share/plymouth/themes 2>&1 | head -n 40
  echo "== plugins"; ls /usr/lib/*/plymouth /usr/lib/plymouth 2>&1
  echo "== conf"; cat /etc/plymouth/plymouthd.conf /usr/share/plymouth/plymouthd.defaults 2>&1
  echo "== fonts"; find / -xdev \( -name '*.ttf' -o -name '*.otf' -o -name fonts.conf \) 2>/dev/null | head -n 20
} > /run/pr7os-asktest-diag 2>&1
echo PARAGON-ASKTEST-ASKING > /dev/ttyS0
mkdir -p /run
plymouth ask-for-password --prompt="UNLOCK THIS PC'S DISK" > /run/pr7os-asktest
ASK
chmod 755 /etc/initramfs-tools/scripts/init-premount/paragon-asktest
update-initramfs -u -k all
