#!/bin/sh
# The look came in as paragon-pr7os-look, whose postinst ran setup_look.py. Run again with --strict: a Plasma whose
# lock screen the edits don't recognise stops the build here (on users' systems it falls back to Plasma's design).
set -e
python3 /usr/share/paragon/setup_look.py configure --strict
grep -q "ParagonClock" /usr/share/plasma/shells/org.kde.plasma.desktop/contents/lockscreen/LockScreenUi.qml \
    || { echo "the lock screen isn't restyled"; exit 1; }
