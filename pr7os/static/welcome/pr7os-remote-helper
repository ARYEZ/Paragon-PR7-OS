#!/usr/bin/python3
"""Remote desktop from Windows through xrdp (as root, started by pkexec from Paragon Welcome). One word only:

    pr7os-remote-helper on      xrdp (and its X server, xorgxrdp) installed if missing, then started now and at
                                every boot: Windows' Remote Desktop Connection logs in with your PR7-OS user name and
                                password and gets a Plasma session of its own (X11)
    pr7os-remote-helper off     stopped, and not started at boot (the packages stay)
    pr7os-remote-helper state   "on" or "off" (no root needed)
    pr7os-remote-helper account <you>-remote, an account of its own for remote desktop (you stay signed in at the PC:
                                one account can't run two desktops); its password is read from standard input (never
                                an argument, which any program could read); no administrator rights. Again = new password

Why xrdp and not Plasma's KRdp: KRdp's H.264 stream was refused by both of Microsoft's clients (Remote Desktop
Connection: protocol error 0xd06; Windows App: "Invalid packet format"), at 4K and at 1080p. The firewall already
lets port 3389 in from home networks only (PR7-OS's setup). Prints STEP / DONE / ERROR lines for the window."""
import os
import pwd
import re
import subprocess
import sys

APT = os.environ.get("PR7OS_APT", "apt-get")
SYSTEMCTL = os.environ.get("PR7OS_SYSTEMCTL", "systemctl")
PACKAGES = ["xrdp", "xorgxrdp"]


def say(line: str) -> None:
    print(line, flush=True)


def installed(pkg: str) -> bool:
    return subprocess.run(["dpkg-query", "-W", "-f", "${db:Status-Status}", pkg], capture_output=True,
                          text=True).stdout.strip() == "installed"


def port_holder() -> str:
    """The program listening on remote desktop's port, "" if none (or ss isn't there)."""
    try:
        out = subprocess.run([os.environ.get("PR7OS_SS", "ss"), "-Hltnp", "sport = :3389"], capture_output=True,
                             text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    m = re.search(r'users:\(\("([^"]+)"', out)
    return m.group(1) if m else ""


def remote_name() -> str:
    """The account for remote desktop: the asking user's name (pkexec says who) + "-remote"."""
    uid = int(os.environ.get("PKEXEC_UID", "-1"))
    try:
        user = pwd.getpwuid(uid).pw_name
    except (KeyError, ValueError):
        return ""
    return f"{user}-remote"[:32] if re.fullmatch(r"[a-z_][a-z0-9_-]*", user) else ""


def account() -> int:
    name = remote_name()
    if not name:
        say("ERROR who asked isn't known (start it with pkexec from your account)")
        return 1
    password = sys.stdin.readline().rstrip("\n")
    if len(password) < 4:
        say("ERROR the password is missing or too short")
        return 1
    try:
        pwd.getpwnam(name)
        exists = True
    except KeyError:
        exists = False
    if not exists:
        say(f"STEP Making the account {name}")
        owner = name[:-len("-remote")]
        if subprocess.run(["useradd", "--create-home", "--shell", "/bin/bash", "--comment",
                           f"Remote desktop ({owner})", name]).returncode:
            say(f"ERROR the account {name} couldn't be made")
            return 1
    say("STEP Setting its password")
    if subprocess.run(["chpasswd"], input=f"{name}:{password}\n", text=True).returncode:
        say("ERROR the password couldn't be set")
        return 1
    say(f"DONE account {name}")
    return 0


def state() -> str:
    done = subprocess.run([SYSTEMCTL, "is-active", "xrdp"], capture_output=True, text=True)
    return "on" if done.stdout.strip() == "active" else "off"


def main(argv: list[str]) -> int:
    word = argv[0] if len(argv) == 1 else ""
    if word == "state":
        say(state())
        return 0
    if word not in ("on", "off", "account"):
        say("ERROR say on, off, state or account")
        return 2
    if os.geteuid() != 0 and not os.environ.get("PR7OS_APT"):
        say("ERROR this needs administrator rights (start it with pkexec)")
        return 1
    if word == "account":
        return account()
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    if word == "on":
        missing = [p for p in PACKAGES if not installed(p)]
        if missing:
            say("STEP Installing the remote desktop server (xrdp)")
            subprocess.run([APT, "-o", "DPkg::Lock::Timeout=600", "update", "-qq"], env=env)
            if subprocess.run([APT, "-o", "DPkg::Lock::Timeout=600", "install", "-y", *missing], env=env).returncode:
                say("ERROR xrdp couldn't be installed (is the PC online?)")
                return 1
        say("STEP Starting it")
        if subprocess.run([SYSTEMCTL, "enable", "--now", "xrdp"]).returncode:
            say("ERROR xrdp didn't start")
            return 1
        holder = port_holder()
        if holder and holder != "xrdp":                  # KRdp started with a desktop takes 3389 and xrdp fails
            say(f"ERROR port 3389 is held by {holder}, not xrdp: stop it, then TURN ON again")
            return 1
    else:
        say("STEP Stopping it")
        subprocess.run([SYSTEMCTL, "disable", "--now", "xrdp"])
    say(f"DONE {word}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
