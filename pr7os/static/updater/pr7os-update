#!/usr/bin/python3
"""Paragon PR7-OS updates.

    pr7os-update            the update window (what's new, UPDATE); with no screen (over SSH) the update itself, in
                            the terminal (your password, then each step)
    pr7os-update --back     over SSH: back to the release before (the window's GO BACK)
    pr7os-update --check    the daily check (the systemd timer): a notification when there's something newer
"""
import os
import subprocess
import sys

sys.path.insert(0, "/usr/share/paragon/update")
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import pr7os_update as u  # noqa: E402

VENV_PYTHON = "/opt/paragon/venv/bin/python"          # PySide6 for the window
WINDOW = "/usr/share/paragon/update/window.py"


HELPER = "/usr/libexec/paragon/pr7os-update-helper"


def has_screen() -> bool:
    """A desktop to show the window on (not an SSH session: Qt would abort with no display)."""
    return bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))


def terminal(back: bool = False) -> int:
    """The update in the terminal: pkexec asks for the password right there, the helper prints every step."""
    return subprocess.call(["pkexec", HELPER] + (["previous"] if back else []))


def window() -> int:
    if has_screen() and os.path.exists(VENV_PYTHON) and os.path.exists(WINDOW):
        os.execv(VENV_PYTHON, [VENV_PYTHON, WINDOW])
    return terminal()


def check() -> int:
    try:
        info = u.latest()
    except u.UpdateError as e:
        print(e)
        return 0                                      # offline: say nothing, try again tomorrow
    have = u.installed()
    pkgs = [] if u.is_older(info, have) else u.pending(info["manifest"], have)      # never offers going back
    if not pkgs or u.skipped() == info["version"]:
        return 0
    done = subprocess.run(["notify-send", "-a", "Paragon PR7-OS", "-i", "pr7os",
                           "--action=update=UPDATE", "--action=later=LATER", "--action=skip=SKIP THIS VERSION",
                           f"Paragon PR7-OS {info['version']} is ready",
                           "The new look, apps and fixes. Updating takes a minute or two."],
                          capture_output=True, text=True)
    answer = done.stdout.strip()
    if answer == "update":
        return window()
    if answer == "skip":
        u.skip(info["version"])
    return 0


if __name__ == "__main__":
    args = sys.argv[1:]
    raise SystemExit(check() if "--check" in args else terminal(back=True) if "--back" in args else window())
